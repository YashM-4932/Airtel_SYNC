# ---------------------------------------------------------------------------
# Language model. Leave LLM_PROVIDER=none to run on rules and templates only.
#
#   Gemini    LLM_PROVIDER=openai_compat  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Groq      LLM_PROVIDER=openai_compat  LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenAI    LLM_PROVIDER=openai_compat  LLM_BASE_URL=https://api.openai.com/v1
#   Ollama    LLM_PROVIDER=openai_compat  LLM_BASE_URL=http://localhost:11434/v1   (no key needed)
#   Anthropic LLM_PROVIDER=anthropic      (LLM_BASE_URL not needed)
#
# LLM_MODEL: pick a current fast model from your provider's model list.
# ---------------------------------------------------------------------------
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=15
# All model calls of one chat turn share this many seconds; after a timeout the model is paused for 60 s
LLM_TURN_BUDGET_S=18
# Optional, only for reasoning models that accept it (for example: low)
LLM_REASONING_EFFORT=

# Pricing and dates
PRICE_POSITION=0.5
GST_RATE=0.18
APP_TODAY=2026-07-15

# Orders, Smart KYC and the back office
# OCR_ENGINE: auto (Tesseract if installed, else RapidOCR), tesseract, rapidocr, or none (customers type details)
OCR_ENGINE=auto
# Full path to tesseract.exe if it is installed but not on PATH
TESSERACT_CMD=
# Back-office key. run.sh / run.bat put a random one here on first run. Left empty, the app makes a random key at
# every start and prints it in the console. The old shipped key "accel-demo" is accepted only when DEMO_MODE=1.
BACKOFFICE_KEY=
# DEMO_MODE=1 is for a local demo only: fixed back-office key "accel-demo", specimen documents, on-screen OTP codes.
DEMO_MODE=0
# Specimen KYC documents as one-click samples. Empty = on for a local (127.0.0.1) server, off on any other HOST.
DEMO_SAMPLES=
# Mobile check before an order is placed. No SMS gateway is connected, so the code is shown on screen only when
# DEMO_OTP is on (empty = on for a local server, off otherwise). Production: replace send_sms() in journey/otp.py.
OTP_REQUIRED=1
DEMO_OTP=
MAX_UPLOAD_MB=8
# Document uploads allowed per address in 10 minutes
UPLOAD_RATE=40
# SQLite file for orders (default: var/udyam.db)
DB_PATH=

# Server
HOST=127.0.0.1
PORT=8000
# Same-origin only by default. List origins separated by commas to let another site call the API.
CORS_ORIGINS=
LOG_LEVEL=INFO
